# PostgreSQL used by docker compose for local development.
DATABASE_URL=postgresql+psycopg://dealership:dealership@localhost:5432/dealership
# Connections kept per API process; Vercel uses 1.
DB_POOL_SIZE=25

# Required, at least 32 characters; the API refuses to start without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=60
ALLOWED_CORS_ORIGINS=http://localhost:5173

# Used only by the manual, idempotent initial-admin seed command.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-this-password

# Published demo logins, used by `make seed-demo` (which also resets the catalogue to
# sample vehicles) and listed on the local sign-in page by the SPA's dev server.
# They are shown publicly, so never reuse a real password here.
DEMO_ADMIN_EMAIL=demo.admin@example.com
DEMO_ADMIN_PASSWORD=demo-admin-password
DEMO_BUYER_EMAIL=demo.buyer@example.com
DEMO_BUYER_PASSWORD=demo-buyer-password
