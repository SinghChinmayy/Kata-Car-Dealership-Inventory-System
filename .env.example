# PostgreSQL used by docker compose for local development.
DATABASE_URL=postgresql+psycopg://dealership:dealership@localhost:5432/dealership

# Required, at least 32 characters; the API refuses to start without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=60
ALLOWED_CORS_ORIGINS=http://localhost:5173

# Used only by the manual, idempotent initial-admin seed command.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-this-password
